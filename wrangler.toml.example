name = "knock-knock-backend"
main = "build/worker/shim.mjs"
compatibility_date = "2026-04-16"

[triggers]
crons = ["*/1 * * * *"]

[build]
command = "worker-build --release"

[vars]
NODE_ENV = "development"
PUSH_MODE = "dev"
CORS_ORIGIN = "*"
SERVICE_VERSION = "local-dev"
ACTION_PROVIDER_MODE = "internal"
ACTION_REMINDER_ENABLED = "true"
ACTION_MESSAGE_ENABLED = "true"
# Set these for real APNs delivery; secrets belong in `wrangler secret put`.
# PUSH_MODE = "both"
# APNS_BUNDLE_ID = "hk.knockknock.app"
# APNS_PRODUCTION = "true"

[[d1_databases]]
binding = "DB"
database_name = "knock-knock"
database_id = "REPLACE_WITH_D1_DATABASE_ID"
migrations_dir = "migrations"
